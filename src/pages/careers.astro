---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MarqueeText from '../components/effects/MarqueeText.astro';

const values = [
  {
    title: 'Be Cool',
    description: 'No assholes. Ask, don\'t tell. Please and thank you go a long way.',
    number: '01',
  },
  {
    title: 'Be Different',
    description: 'KUT | THRŪ the noise. Command attention. We\'re not here for quick wins—we\'re building brands that last.',
    number: '02',
  },
  {
    title: 'Be the Buffalo',
    description: 'Cattle run from storms, resulting in a longer struggle. The buffalo charges into the storm to get through it faster. Be the buffalo.',
    number: '03',
  },
  {
    title: 'FIO Then Own It',
    description: 'Figure it out. Do the research, make the call, watch the video, ask the question. Own your actions and outcomes. Take accountability. Decisions create your reality.',
    number: '04',
  },
  {
    title: 'Lead with Fear',
    description: 'Yea, no. Just keep it real with open, honest communication. Say the hard things, talk it out, and stay connected. The best creative work doesn\'t come from intimidation—it comes from inspiration.',
    number: '05',
  },
];
---

<Layout
  title="Careers | KUT | THRŪ Media"
  description="Join KUT | THRŪ Media. We work with companies that build stuff, fix stuff, and keep the country running. Roll up your sleeves and create badass work. Apply today."
>
  <Header />

  <main class="flex-1">
    <!-- Hero Section -->
    <section class="relative min-h-[70vh] flex items-end pb-16 overflow-hidden">
      <!-- Background -->
      <div class="absolute inset-0 bg-charcoal"></div>
      <!-- Animated lines -->
      <div class="absolute inset-0 overflow-hidden opacity-20">
        <div class="absolute top-0 left-1/4 w-px h-full bg-gradient-to-b from-transparent via-power-red to-transparent"></div>
        <div class="absolute top-0 left-1/2 w-px h-full bg-gradient-to-b from-transparent via-white/20 to-transparent"></div>
        <div class="absolute top-0 left-3/4 w-px h-full bg-gradient-to-b from-transparent via-power-red to-transparent"></div>
      </div>

      <div class="container relative z-10 pt-40">
        <span class="eyebrow block mb-6" data-animate="fade-up">Join the Crew</span>
        <h1 class="headline-xl mb-6" data-animate="fade-up">
          Clean Marketing for Dirty Jobs.
        </h1>
        <p class="body-lg text-muted max-w-xl" data-animate="fade-up">
          We don't do fluff. We work with companies that actually build stuff, fix stuff, and keep the country running.
        </p>
      </div>
    </section>

    <!-- Marquee -->
    <section class="py-6 border-y border-white/5 bg-charcoal-light overflow-hidden">
      <MarqueeText
        text="ROLL UP YOUR SLEEVES AND CREATE BADASS WORK"
        speed={15}
        class="text-xl font-bold text-text-subtle/20"
      />
    </section>

    <!-- Intro -->
    <section class="section bg-charcoal">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center">
          <span class="eyebrow block mb-6" data-animate="fade-up">Ready to Build?</span>
          <h2 class="headline-md mb-6" data-animate="fade-up">If you're ready to roll up your sleeves and create badass work. Start here.</h2>
          <p class="body-lg text-muted" data-animate="fade-up">
            Tell us about yourself below. Fill out the application, drop your resume, and let us know which of our core values hit home. If it's a fit, we'll be in touch.
          </p>
        </div>
      </div>
    </section>

    <!-- Core Values Section -->
    <section class="section bg-charcoal-light">
      <div class="container">
        <div class="max-w-2xl mx-auto text-center mb-16" data-animate="fade-up">
          <span class="eyebrow block mb-6">What We Live By</span>
          <h2 class="headline-md mb-4">We Live and Breathe These Core Values</h2>
          <p class="text-muted">You'll be asked which two hit home the most, so read them like you mean it.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {values.map((value, index) => (
            <div class={`card card-highlight ${index === 4 ? 'md:col-span-2 lg:col-span-1' : ''}`} data-animate="fade-up">
              <span class="text-5xl font-black text-power-red/20 mb-4 block">{value.number}</span>
              <h3 class="text-xl font-bold mb-3">{value.title}</h3>
              <p class="text-muted">{value.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Application Form -->
    <section class="section bg-charcoal">
      <div class="container">
        <div class="max-w-2xl mx-auto">
          <div class="text-center mb-12" data-animate="fade-up">
            <span class="eyebrow block mb-6">The Application</span>
            <h2 class="headline-md mb-4">Start Your Application</h2>
            <p class="text-muted">Fields marked with an asterisk are required. You'll be able to upload your resume at the bottom.</p>
          </div>

          <div data-animate="fade-up">
            <div id="dt-form-job-application"></div>
            <script is:inline src="https://devtools.prairiegiraffe.com/form-embed.js?v=2"
              data-project="proj_em8foyyu"
              data-form="job-application"
              data-target="dt-form-job-application"
              defer></script>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
